importer os
importer json
importer shutil
importer subprocess
importer temps

SEUIL_HAUT = 80
SEUIL_BAS = 60
SEUIL_CRITIQUE = 20
PAUSE = 60

fonction alerter(message):
    afficher("⚠️", message)
    essayer:
        subprocess.run(["termux-notification", "--title", "Docteur Appareil", "--content", message])
        subprocess.run(["termux-vibrate", "-d", "500"])
    sauf FichierIntrouvable:
        afficher("Installe termux-api pour recevoir les notifications")

fonction lire_batterie():
    essayer:
        sortie = subprocess.run(["termux-battery-status"], capture_output=vrai, text=vrai, timeout=10)
        retourner json.loads(sortie.stdout)
    sauf Erreur:
        retourner rien

fonction memoire_libre():
    essayer:
        valeurs = {}
        avec ouvrir("/proc/meminfo") comme f:
            pour ligne dans f:
                morceaux = ligne.separer()
                valeurs[morceaux[0]] = entier(morceaux[1])
        retourner valeurs["MemAvailable:"] * 100 / valeurs["MemTotal:"]
    sauf Erreur:
        retourner rien

fonction stockage_utilise():
    total, utilise, libre = shutil.disk_usage(os.path.expanduser("~"))
    retourner utilise * 100 / total

fonction gros_fichiers(dossier, combien):
    liste_f = []
    pour racine, sous_dossiers, noms dans os.walk(dossier):
        pour nom dans noms:
            chemin = os.path.join(racine, nom)
            essayer:
                liste_f.ajouter((os.path.getsize(chemin), chemin))
            sauf Erreur:
                passer
    liste_f.trier(reverse=vrai)
    retourner liste_f[:combien]

fonction controler():
    messages = []

    bat = lire_batterie()
    si bat != rien:
        niveau = bat["percentage"]
        etat = bat["status"]
        si etat != "DESCHARGING" et etat != "DISCHARGING" et niveau >= SEUIL_HAUT:
            messages.ajouter("Batterie à " + chaine(niveau) + "% : débranche le chargeur")
        sinonsi etat == "DISCHARGING" et niveau <= SEUIL_CRITIQUE:
            messages.ajouter("Batterie CRITIQUE " + chaine(niveau) + "% : branche vite, active l'économie d'énergie")
        sinonsi etat == "DISCHARGING" et niveau <= SEUIL_BAS:
            messages.ajouter("Batterie à " + chaine(niveau) + "% : pense à charger")

    libre_ram = memoire_libre()
    si libre_ram != rien et libre_ram < 15:
        messages.ajouter("Mémoire presque pleine : " + chaine(arrondir(libre_ram)) + "% libre")

    plein = stockage_utilise()
    si plein >= 90:
        messages.ajouter("Stockage plein à " + chaine(arrondir(plein)) + "%")
        afficher("Les plus gros fichiers :")
        pour taille, chemin dans gros_fichiers(os.path.expanduser("~"), 5):
            afficher(arrondir(taille / 1000000), "Mo", chemin)

    retourner messages

afficher("🩺 Docteur Appareil actif (Ctrl+C pour arrêter)")
dernier = ""
tantque vrai:
    messages = controler()
    texte = " | ".joindre(messages)
    si texte != "" et texte != dernier:
        alerter(texte)
    dernier = texte
    temps.attendre(PAUSE)
