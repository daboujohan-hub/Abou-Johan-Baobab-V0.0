fonction ecrire_journal(texte):
    essayer:
        avec verrou_journal:
            si os.path.exists(FICHIER_JOURNAL) et os.path.getsize(FICHIER_JOURNAL) > 1000000:
                os.replace(FICHIER_JOURNAL, FICHIER_JOURNAL + ".ancien")
            avec ouvrir(FICHIER_JOURNAL, "a", encoding="utf-8") comme f:
                f.write(datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S") + " | " + texte + "\n")
    sauf Erreur:
        passer

fonction charger_json(chemin, defaut):
    essayer:
        avec ouvrir(chemin, encoding="utf-8") comme f:
            retourner json.load(f)
    sauf Erreur:
        retourner defaut

fonction sauver_json(chemin, donnees):
    essayer:
        avec ouvrir(chemin + ".tmp", "w", encoding="utf-8") comme f:
            json.dump(donnees, f, ensure_ascii=faux)
        os.replace(chemin + ".tmp", chemin)
    sauf Erreur comme e:
        ecrire_journal("Écriture de " + chemin + " : erreur " + chaine(e))

fonction lire_nombre(chemin):
    essayer:
        avec ouvrir(chemin) comme f:
            retourner decimal(f.read().nettoyer())
    sauf Erreur:
        retourner 0

fonction marquer_execution(chemin):
    essayer:
