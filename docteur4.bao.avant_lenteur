        sauf Erreur comme e:
            ok = faux
            details = chaine(e)
        si ok:
            reussis = reussis + 1
            ecrire_journal("GitHub : " + chemin + " sauvegardé sur la branche docteur-sauvegarde")
        sinon:
            echecs.ajouter(os.path.basename(chemin))
            ecrire_journal("GitHub : échec pour " + chemin + " : " + details)
    marquer_execution(FICHIER_GITHUB_T)
    si longueur(echecs) > 0:
        signaler("Sauvegarde", "github_echec_" + chaine(entier(temps.maintenant())), 2, "Envoi GitHub échoué pour : " + ", ".joindre(echecs), "Vérifie ta connexion et tes accès GitHub. Détails dans docteur.log.")
