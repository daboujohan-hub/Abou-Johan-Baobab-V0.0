fonction empreinte(chemin):
    h = hashlib.md5()
    avec ouvrir(chemin, "rb") comme f:
        tantque vrai:
            bloc = f.read(1048576)
            si non bloc:
                arreter
            h.update(bloc)
    retourner h.hexdigest()

fonction agent_doublons():
    par_taille = {}
    pour dossier dans [DOSSIER_DOWNLOAD] + DOSSIERS_PROJETS:
        pour racine, sous_dossiers, noms dans os.walk(dossier):
            sous_dossiers[:] = garder_dossiers(sous_dossiers)
            pour nom dans noms:
                chemin = os.path.join(racine, nom)
                essayer:
                    taille = os.path.getsize(chemin)
                sauf Erreur:
                    continuer
                si taille >= 51200 et taille <= 52428800:
                    par_taille.setdefault(taille, []).ajouter(chemin)
    groupes = []
    recup = 0
    pour taille, chemins dans par_taille.elements():
        si longueur(chemins) < 2:
            continuer
        par_hash = {}
        pour c dans chemins:
            essayer:
                par_hash.setdefault(empreinte(c), []).ajouter(c)
            sauf Erreur:
                passer
        pour h, copies dans par_hash.elements():
            si longueur(copies) >= 2:
                groupes.ajouter({"taille": taille, "copies": copies})
                recup = recup + taille * (longueur(copies) - 1)
    groupes.trier(key=anonyme g: g["taille"] * longueur(g["copies"]), reverse=vrai)
    sauver_json(FICHIER_DOUBLONS, groupes[:50])
    recup_mo = recup / 1000000
    etat_global["doublons_mo"] = arrondir(recup_mo, 1)
    si recup_mo >= 100:
        signaler("Stockage", "doublons", 2, chaine(longueur(groupes)) + " groupes de doublons, " + chaine(arrondir(recup_mo)) + " Mo récupérables", "Ouvre le menu, option doublons, pour les voir. Rien n'est supprimé sans ta confirmation.")
    sinonsi longueur(groupes) > 0:
        ecrire_journal("Doublons : " + chaine(longueur(groupes)) + " groupes, " + chaine(arrondir(recup_mo, 1)) + " Mo récupérables")

fonction agent_croissance():
    t_actuel = temps.maintenant()
    ancien = charger_json(FICHIER_CROISSANCE, rien)
    si ancien != rien et t_actuel - ancien["t"] < 72000:
        retourner
    tailles = {}
    pour nom dans os.listdir(MAISON):
        chemin = MAISON + "/" + nom
        si os.path.isdir(chemin) et non os.path.islink(chemin):
            tailles[nom] = taille_brute(chemin)
    si ancien != rien:
        diffs = []
        pour nom, octets dans tailles.elements():
            avant = ancien["tailles"].get(nom, 0)
            diffs.ajouter(((octets - avant) / 1000000, nom))
        diffs.trier(reverse=vrai)
        si longueur(diffs) > 0 et diffs[0][0] >= R["CROISSANCE_MO_JOUR"]:
            signaler("Stockage", "croissance_" + chaine(entier(t_actuel)), 2, "Le dossier " + diffs[0][1] + " a grossi de " + chaine(arrondir(diffs[0][0])) + " Mo en une journée", "Vérifie ce qui s'y accumule (cache, téléchargements, journaux).")
        sinonsi longueur(diffs) > 0:
            ecrire_journal("Croissance : le plus gros changement est " + diffs[0][1] + " (" + chaine(arrondir(diffs[0][0], 1)) + " Mo)")
    sauver_json(FICHIER_CROISSANCE, {"t": t_actuel, "tailles": tailles})

