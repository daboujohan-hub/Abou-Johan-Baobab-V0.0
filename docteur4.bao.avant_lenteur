fonction traiter(evenement):
    agent, cle, gravite, message, explication = evenement
    t_actuel = temps.maintenant()
    dernier_t = derniere_fois.get(cle, 0)
    si t_actuel - dernier_t < PAUSES_REPETITION[gravite]:
        retourner
    derniere_fois[cle] = t_actuel
    heure_txt = datetime.datetime.now().strftime("%H:%M")
    avec verrou:
        historique.ajouter((heure_txt, agent, gravite, message, explication))
        si longueur(historique) > 300:
            historique.depiler(0)
    ecrire_journal("[" + agent + "] G" + chaine(gravite) + " " + message)
    afficher("[" + agent + "]", message, flush=vrai)
    si gravite == 1:
        retourner
    si en_dnd():
        si gravite == 3:
            notifier(agent, message + " - " + explication)
        retourner
    calme = est_la_nuit()
    si gravite == 3 ou non calme:
        notifier(agent, message + " - " + explication)
    si gravite == 3:
        vibrer()
    si non calme:
        si gravite == 3:
            parler(agent + ". " + message + ". " + explication)
        sinon:
            parler(message)

