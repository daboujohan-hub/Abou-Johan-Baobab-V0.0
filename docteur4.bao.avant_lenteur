fonction score_sante():
    score = 100
    raisons = []
    bat = etat_global["batterie"]
    si bat != rien:
        en_charge = bat["plugged"] != "UNPLUGGED"
        niveau = bat["percentage"]
        chaleur = bat["temperature"]
        si bat["health"] != "GOOD":
            score = score - 20
            raisons.ajouter("batterie en mauvaise santé (-20)")
        si chaleur >= R["SEUIL_CHALEUR_GRAVE"]:
            score = score - 20
            raisons.ajouter("téléphone très chaud (-20)")
        sinonsi chaleur >= R["SEUIL_CHALEUR"]:
            score = score - 10
            raisons.ajouter("téléphone chaud (-10)")
        si non en_charge et niveau <= R["SEUIL_CRITIQUE"]:
            score = score - 15
            raisons.ajouter("batterie critique (-15)")
        sinonsi non en_charge et niveau <= R["SEUIL_BAS"]:
            score = score - 8
            raisons.ajouter("batterie basse (-8)")
        si etat_global["debut_charge"] != rien:
            si (temps.maintenant() - etat_global["debut_charge"]) / 3600 >= R["HEURES_CHARGE_MAX"]:
                score = score - 5
                raisons.ajouter("charge trop longue (-5)")
    libre_ram = memoire_libre()
    si libre_ram != rien:
        si libre_ram < R["SEUIL_RAM_GRAVE"]:
            score = score - 15
            raisons.ajouter("mémoire presque saturée (-15)")
        sinonsi libre_ram < R["SEUIL_RAM"]:
            score = score - 8
            raisons.ajouter("mémoire faible (-8)")
    plein = stockage_utilise()
    si plein >= R["SEUIL_STOCKAGE_GRAVE"]:
        score = score - 20
        raisons.ajouter("stockage presque plein (-20)")
    sinonsi plein >= R["SEUIL_STOCKAGE"]:
        score = score - 10
        raisons.ajouter("stockage élevé (-10)")
    si etat_global["reseau_perdu"] != rien:
        score = score - 10
        raisons.ajouter("Internet coupé (-10)")
    retourner maximum(0, score), raisons

