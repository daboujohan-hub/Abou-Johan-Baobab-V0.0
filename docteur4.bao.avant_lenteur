fonction cle_chiffrement():
    si non os.path.exists(FICHIER_CLE):
        cle = Fernet.generate_key()
        avec ouvrir(FICHIER_CLE, "wb") comme f:
            f.write(cle)
        os.chmod(FICHIER_CLE, 384)
        ecrire_journal("Clé de chiffrement créée : copie " + FICHIER_CLE + " dans un endroit sûr, sans elle les sauvegardes sont illisibles")
    avec ouvrir(FICHIER_CLE, "rb") comme f:
        retourner f.read()

fonction chiffrer_dossier(nom_dossier):
    archive = shutil.make_archive(nom_dossier, "gztar", nom_dossier)
    si os.path.getsize(archive) > 104857600:
        os.remove(archive)
        retourner faux
    avec ouvrir(archive, "rb") comme f:
        donnees = f.read()
    secret = Fernet(cle_chiffrement()).encrypt(donnees)
    sortie = nom_dossier + ".tar.gz.enc"
    avec ouvrir(sortie, "wb") comme f:
        f.write(secret)
    os.remove(archive)
    si os.path.getsize(sortie) > 0:
        shutil.rmtree(nom_dossier)
        retourner vrai
    retourner faux

