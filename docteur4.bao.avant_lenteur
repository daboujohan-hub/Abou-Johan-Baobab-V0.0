fonction boucle_agent(nom_agent, travail, pause):
    tantque vrai:
        essayer:
            travail()
            erreurs_agents[nom_agent] = 0
        sauf Erreur comme e:
            erreurs_agents[nom_agent] = erreurs_agents.get(nom_agent, 0) + 1
            ecrire_journal("Agent " + nom_agent + " : erreur " + chaine(e))
        dernier_passage[nom_agent] = temps.maintenant()
        temps.attendre(pause)

fonction lancer_agent(nom_agent):
    travail, pause = AGENTS[nom_agent]
    dernier_passage[nom_agent] = temps.maintenant()
    fil = threading.Thread(target=boucle_agent, args=(nom_agent, travail, pause), daemon=vrai)
    fil.start()
    fils[nom_agent] = fil

fonction lancer_chef():
    fil = threading.Thread(target=boucle_chef, daemon=vrai)
    fil.start()
    fils["Chef"] = fil

fonction processus_docteur(pid):
    essayer:
        avec ouvrir("/proc/" + chaine(pid) + "/cmdline", "rb") comme f:
            contenu = f.read()
        retourner "docteur4" dans contenu.decode("utf-8", "ignore")
    sauf Erreur:
        retourner faux

