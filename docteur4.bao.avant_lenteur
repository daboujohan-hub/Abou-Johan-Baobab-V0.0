fonction git(chemin, arguments):
    retourner subprocess.run(["git", "-C", chemin] + arguments, capture_output=vrai, text=vrai, timeout=180)

fonction pousser_depot(chemin):
    r1 = git(chemin, ["stash", "create"])
    sha = r1.stdout.nettoyer()
    si sha == "":
        sha = "HEAD"
    r2 = git(chemin, ["push", "--force", "origin", sha + ":refs/heads/docteur-sauvegarde"])
    retourner r2.returncode == 0, r2.stderr.nettoyer()[-200:]

fonction agent_github():
    si non os.path.exists(FICHIER_DEPOTS):
        retourner
    si temps.maintenant() - lire_nombre(FICHIER_GITHUB_T) < 86400:
        retourner
    avec ouvrir(FICHIER_DEPOTS, encoding="utf-8") comme f:
        lignes_d = f.read().splitlines()
    echecs = []
    reussis = 0
    pour ligne dans lignes_d:
        chemin = os.path.expanduser(ligne.nettoyer())
        si chemin == "":
            continuer
        si non os.path.isdir(chemin + "/.git"):
            echecs.ajouter(os.path.basename(chemin) + " (pas un dépôt git)")
            continuer
        essayer:
