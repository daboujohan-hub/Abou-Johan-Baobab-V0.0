fonction charger_reglages():
    essayer:
        si non os.path.exists(FICHIER_REGLAGES):
            sauver_json(FICHIER_REGLAGES, R)
        date_modif = os.path.getmtime(FICHIER_REGLAGES)
        si date_modif == etat_global.get("reglages_mtime"):
            retourner
        lus = charger_json(FICHIER_REGLAGES, {})
        changes = []
        pour cle, valeur dans lus.elements():
            si cle dans R et est_instance(valeur, (int, float)) et non est_instance(valeur, bool):
                si R[cle] != valeur:
                    R[cle] = valeur
                    changes.ajouter(cle + "=" + chaine(valeur))
        manquants = faux
        pour cle dans R:
            si cle non dans lus:
                manquants = vrai
        si manquants:
            sauver_json(FICHIER_REGLAGES, R)
            date_modif = os.path.getmtime(FICHIER_REGLAGES)
        etat_global["reglages_mtime"] = date_modif
        si longueur(changes) > 0:
            ecrire_journal("Réglages rechargés : " + ", ".joindre(changes))
    sauf Erreur comme e:
        ecrire_journal("Réglages : erreur " + chaine(e))

fonction en_silence():
    retourner temps.maintenant() < lire_nombre(FICHIER_SILENCE)

fonction en_dnd():
    retourner temps.maintenant() < lire_nombre(FICHIER_DND)

fonction est_la_nuit():
    h = datetime.datetime.now().hour
    retourner h >= R["HEURE_NUIT_DEBUT"] ou h < R["HEURE_NUIT_FIN"] ou en_silence()

