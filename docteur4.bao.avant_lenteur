fonction mesurer_latence():
    mesures = []
    pour i dans intervalle(3):
        debut = temps.maintenant()
        essayer:
            c = socket.create_connection(("8.8.8.8", 53), timeout=3)
            c.close()
            mesures.ajouter((temps.maintenant() - debut) * 1000)
        sauf Erreur:
            passer
    si longueur(mesures) == 0:
        retourner rien
    retourner somme(mesures) / longueur(mesures)

fonction mesurer_debit():
