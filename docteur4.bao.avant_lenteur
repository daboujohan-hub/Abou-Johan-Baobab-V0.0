    si non en_charge et niveau <= R["SEUIL_CRITIQUE"]:
        signaler("Batterie", "batterie_critique", 3, "Batterie critique : " + chaine(niveau) + " pour cent", "Branche vite ton téléphone, sinon il va s'éteindre.")
