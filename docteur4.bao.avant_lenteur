    si avant == rien:
        retourner
    si en_charge et non avant:
        etat_global["session"] = {"debut_t": t_actuel, "debut_pct": niveau, "heure": datetime.datetime.now().hour}
    sinonsi avant et non en_charge:
        s = etat_global["session"]
        si s != rien:
            s["fin_pct"] = niveau
            s["duree_min"] = entier((t_actuel - s["debut_t"]) / 60)
            habitudes.ajouter(s)
            si longueur(habitudes) > 60:
                habitudes.depiler(0)
            sauver_json(FICHIER_HABITUDES, habitudes)
            etat_global["session"] = rien

fonction conseils_habitudes():
    liste_h = habitudes[-30:]
    si longueur(liste_h) < 3:
        retourner ["Pas encore assez de charges observées (il en faut 3) pour donner des conseils."]
    pleines = 0
    nuits = 0
    total_debut = 0
    pour s dans liste_h:
        total_debut = total_debut + s["debut_pct"]
        si s["fin_pct"] >= 95:
            pleines = pleines + 1
        si (s["heure"] >= 21 ou s["heure"] <= 3) et s["duree_min"] >= 360:
            nuits = nuits + 1
    nb = longueur(liste_h)
    moyenne = entier(total_debut / nb)
    conseils = ["Sur tes " + chaine(nb) + " dernières charges, tu branches en moyenne à " + chaine(moyenne) + " pour cent."]
    si moyenne < 20:
        conseils.ajouter("Tu laisses la batterie descendre très bas. Branche plutôt vers 30 pour cent.")
    si pleines * 2 >= nb:
        conseils.ajouter("Plus de la moitié de tes charges vont jusqu'à 100 pour cent. S'arrêter vers 80 pour cent ménage la batterie.")
    si nuits * 3 >= nb:
        conseils.ajouter("Tu charges souvent toute la nuit. Branche plus tard, ou débranche dès que tu te réveilles.")
    si longueur(conseils) == 1:
        conseils.ajouter("Tes habitudes de charge sont bonnes.")
    retourner conseils

