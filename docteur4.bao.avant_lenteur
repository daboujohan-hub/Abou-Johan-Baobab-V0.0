fonction garder_dossiers(sous_dossiers):
    gardes = []
    pour d dans sous_dossiers:
        si d non dans IGNORES:
            gardes.ajouter(d)
    retourner gardes

fonction taille_dossier(dossier):
    somme_o = 0
    pour racine, sous_dossiers, noms dans os.walk(dossier):
        sous_dossiers[:] = garder_dossiers(sous_dossiers)
        pour nom dans noms:
            essayer:
                somme_o = somme_o + os.path.getsize(os.path.join(racine, nom))
            sauf Erreur:
                passer
    retourner somme_o

fonction taille_brute(dossier):
    somme_o = 0
    pour racine, sous_dossiers, noms dans os.walk(dossier):
        pour nom dans noms:
            essayer:
                somme_o = somme_o + os.path.getsize(os.path.join(racine, nom))
            sauf Erreur:
                passer
    retourner somme_o

fonction gros_fichiers(dossier, combien):
    liste_f = []
    pour racine, sous_dossiers, noms dans os.walk(dossier):
        sous_dossiers[:] = garder_dossiers(sous_dossiers)
        pour nom dans noms:
            chemin = os.path.join(racine, nom)
            essayer:
                liste_f.ajouter((os.path.getsize(chemin), chemin))
            sauf Erreur:
                passer
    liste_f.trier(reverse=vrai)
    retourner liste_f[:combien]

fonction trouver_apk(dossier):
    resultat = []
    pour racine, sous_dossiers, noms dans os.walk(dossier):
        pour nom dans noms:
            si nom.endswith(".apk"):
                resultat.ajouter(os.path.join(racine, nom))
    retourner resultat

fonction estimer_autonomie():
    ech = etat_global["echantillons"]
    si longueur(ech) < 2:
        retourner rien
    premier = ech[0]
    dernier_ech = ech[-1]
    duree_h = (dernier_ech[1] - premier[1]) / 3600
    baisse = premier[0] - dernier_ech[0]
    si duree_h < 0.15 ou baisse <= 0:
        retourner rien
    rythme = baisse / duree_h
    retourner dernier_ech[0] / rythme

fonction noter_habitude(en_charge, niveau, t_actuel):
    avant = etat_global["etait_en_charge"]
