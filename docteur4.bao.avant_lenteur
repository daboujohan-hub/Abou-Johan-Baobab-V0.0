fonction alertes_par_agent(jours):
    limite = (datetime.datetime.now() - datetime.timedelta(days=jours)).strftime("%Y-%m-%d %H:%M:%S")
    comptes = {}
    si non os.path.exists(FICHIER_JOURNAL):
        retourner comptes
