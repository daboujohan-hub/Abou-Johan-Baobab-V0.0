                essayer:
                    agent = ligne.separer("[", 1)[1].separer("]")[0]
                    comptes[agent] = comptes.get(agent, 0) + 1
                sauf Erreur:
                    passer
    retourner comptes

fonction construire_rapport_semaine(jour):
    lignes = ["RAPPORT DE LA SEMAINE - " + jour, ""]
    mesures = lignes_csv(7)
    si longueur(mesures) == 0:
        lignes.ajouter("Pas encore de mesures sur 7 jours.")
    sinon:
        scores = []
        temperatures = []
        rams = []
        pour m dans mesures:
            v = convertir(m[6])
            si v != rien:
                scores.ajouter(v)
            v = convertir(m[2])
            si v != rien:
                temperatures.ajouter(v)
            v = convertir(m[4])
            si v != rien:
                rams.ajouter(v)
        si longueur(scores) > 0:
            lignes.ajouter("Score de santé : moyenne " + chaine(arrondir(somme(scores) / longueur(scores))) + "/100, le pire " + chaine(entier(minimum(scores))) + "/100")
        si longueur(temperatures) > 0:
            lignes.ajouter("Température : maximum " + chaine(maximum(temperatures)) + " C")
        si longueur(rams) > 0:
            lignes.ajouter("Mémoire libre : minimum " + chaine(entier(minimum(rams))) + " pour cent")
        debut_s = convertir(mesures[0][5])
        fin_s = convertir(mesures[-1][5])
        si debut_s != rien et fin_s != rien:
            lignes.ajouter("Stockage : de " + chaine(entier(debut_s)) + " à " + chaine(entier(fin_s)) + " pour cent")
        lignes.ajouter("Nombre de mesures : " + chaine(longueur(mesures)))
    lignes.ajouter("")
    comptes = alertes_par_agent(7)
    si longueur(comptes) == 0:
        lignes.ajouter("Aucune alerte importante cette semaine.")
    sinon:
        lignes.ajouter("Alertes importantes par agent :")
        pour agent, nb dans comptes.elements():
            lignes.ajouter("- " + agent + " : " + chaine(nb))
    lignes.ajouter("")
    lignes.ajouter("Habitudes de charge :")
    pour conseil dans conseils_habitudes():
        lignes.ajouter("- " + conseil)
    si etat_global["doublons_mo"] > 0:
        lignes.ajouter("")
        lignes.ajouter("Doublons : environ " + chaine(etat_global["doublons_mo"]) + " Mo récupérables (menu, option doublons)")
    retourner "\n".joindre(lignes)

fonction construire_rapport(jour):
    lignes = ["RAPPORT DU DOCTEUR - " + jour, ""]
    score, raisons = score_sante()
    lignes.ajouter("Score de santé : " + chaine(score) + "/100 (" + etiquette_score(score) + ")")
    pour r dans raisons:
        lignes.ajouter("   - " + r)
    lignes.ajouter("")
    bat = etat_global["batterie"]
    si bat != rien:
        lignes.ajouter("Batterie : " + chaine(bat["percentage"]) + "% | " + chaine(bat["status"]) + " | " + chaine(bat["temperature"]) + " C | santé " + chaine(bat["health"]))
    libre_ram = memoire_libre()
    si libre_ram != rien:
        lignes.ajouter("Mémoire libre : " + chaine(arrondir(libre_ram)) + "%")
    lignes.ajouter("Stockage utilisé : " + chaine(arrondir(stockage_utilise())) + "%")
    si etat_global["reseau_perdu"] == rien:
        lignes.ajouter("Internet : OK")
    sinon:
        lignes.ajouter("Internet : COUPÉ")
    lignes.ajouter("")
    avec verrou:
        evenements = en_liste(historique)
        historique.vider()
    si longueur(evenements) == 0:
        lignes.ajouter("Aucune alerte depuis le dernier rapport. Tout va bien.")
    sinon:
        lignes.ajouter("ALERTES (" + chaine(longueur(evenements)) + ") :")
        pour ev dans evenements:
            lignes.ajouter("- " + ev[0] + " [" + ev[1] + "] " + ev[3])
            lignes.ajouter("    explication : " + ev[4])
    si longueur(etat_global["gros"]) > 0:
        lignes.ajouter("")
        lignes.ajouter("Les plus gros fichiers :")
        pour taille, chemin dans etat_global["gros"]:
            lignes.ajouter("- " + chaine(arrondir(taille / 1000000)) + " Mo : " + chemin)
    retourner "\n".joindre(lignes), evenements, score

fonction resume_vocal(score, evenements):
    phrase = "Bonjour Abou. Ton score de santé est de " + chaine(score) + " sur 100, " + etiquette_score(score) + "."
    bat = etat_global["batterie"]
    si bat != rien:
        phrase = phrase + " Batterie à " + chaine(bat["percentage"]) + " pour cent."
    phrase = phrase + " Stockage à " + chaine(arrondir(stockage_utilise())) + " pour cent."
    si longueur(evenements) == 0:
        phrase = phrase + " Aucune alerte. Bonne journée."
    sinon:
        principale = evenements[0]
        pour ev dans evenements:
            si ev[2] > principale[2]:
                principale = ev
        phrase = phrase + " Il y a " + chaine(longueur(evenements)) + " alertes. La principale : " + principale[3] + "."
    retourner phrase

fonction notifier_whatsapp(titre_n, texte):
    lien = "https://wa.me/" + NUMERO_WHATSAPP + "?text=" + urllib.parse.quote(texte[:1200])
    essayer:
        subprocess.run(["termux-notification", "--title", titre_n, "--content", "Touche pour l'envoyer sur WhatsApp", "--action", "termux-open-url '" + lien + "'"], timeout=20)
    sauf Erreur:
        passer

fonction agent_rapport():
    maintenant_dt = datetime.datetime.now()
    si maintenant_dt.hour < R["HEURE_RAPPORT"] ou maintenant_dt.hour >= 12:
        retourner
    os.makedirs(DOSSIER_RAPPORTS, exist_ok=vrai)
    jour = maintenant_dt.date().isoformat()
    annee, semaine, jour_sem = maintenant_dt.isocalendar()
    chemin_s = DOSSIER_RAPPORTS + "/semaine_" + chaine(annee) + "-S" + chaine(semaine) + ".txt"
    si maintenant_dt.weekday() == R["JOUR_RAPPORT_SEMAINE"] et non os.path.exists(chemin_s):
        texte_s = construire_rapport_semaine(jour)
        avec ouvrir(chemin_s, "w", encoding="utf-8") comme f:
            f.write(texte_s)
        ecrire_journal("Rapport de la semaine écrit : " + chemin_s)
        notifier_whatsapp("Docteur - rapport de la semaine", texte_s)
    chemin = DOSSIER_RAPPORTS + "/rapport_" + jour + ".txt"
    si os.path.exists(chemin):
        retourner
    texte, evenements, score = construire_rapport(jour)
    avec ouvrir(chemin, "w", encoding="utf-8") comme f:
        f.write(texte)
    ecrire_journal("Rapport écrit : " + chemin)
    notifier_whatsapp("Docteur - rapport prêt", texte)
    si non est_la_nuit() et non en_dnd():
        parler(resume_vocal(score, evenements))

fonction agent_annonces():
    maintenant_dt = datetime.datetime.now()
    jour = maintenant_dt.date().isoformat()
    heure_actuelle = maintenant_dt.hour
    si en_dnd() ou en_silence():
        retourner
    deja = charger_json(FICHIER_ANNONCES, {})
    si heure_actuelle == R["HEURE_NUIT_FIN"] et deja.get("matin") != jour:
        deja["matin"] = jour
        sauver_json(FICHIER_ANNONCES, deja)
        nb = longueur(historique)
        phrase = "Bonjour Abou. Il est " + chaine(heure_actuelle) + " heures. Je recommence à te parler pour t'expliquer les problèmes de ton appareil."
        si nb > 0:
            phrase = phrase + " Pendant la nuit, il y a eu " + chaine(nb) + " alertes. Tu les trouveras dans ton rapport."
        sinon:
            phrase = phrase + " Aucune alerte pendant la nuit."
        ecrire_journal("Annonce du matin")
        parler(phrase)
    sinonsi heure_actuelle == R["HEURE_NUIT_DEBUT"] et deja.get("soir") != jour:
        deja["soir"] = jour
        sauver_json(FICHIER_ANNONCES, deja)
        ecrire_journal("Annonce du soir")
        parler("Il est " + chaine(heure_actuelle) + " heures. Je passe en mode silencieux pour la nuit. Seules les alertes graves seront notifiées. Bonne nuit Abou.")

