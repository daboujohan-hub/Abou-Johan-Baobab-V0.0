importer os
importer json
importer shutil
importer subprocess
importer temps
importer dates

SEUIL_HAUT = 80
SEUIL_BAS = 30
SEUIL_CRITIQUE = 20
SEUIL_CHALEUR = 40
SEUIL_RAM = 15
SEUIL_STOCKAGE = 90
SEUIL_DOWNLOAD_MO = 300
HEURES_CHARGE_MAX = 3
PAUSE = 60
DOSSIER_DOWNLOAD = os.path.expanduser("~/storage/shared/Download")
FICHIER_JOURNAL = "docteur.log"

suivi = {"niveau": rien, "debut_charge": rien, "cycle": 0, "msg_download": ""}

fonction ecrire_journal(texte):
    essayer:
        avec ouvrir(FICHIER_JOURNAL, "a", encoding="utf-8") comme f:
            f.write(dates.date_du_jour() + " " + dates.heure() + " | " + texte + "\n")
    sauf Erreur:
        passer

fonction alerter(message):
    afficher("⚠️", message)
    ecrire_journal(message)
    essayer:
        subprocess.run(["termux-notification", "--title", "Docteur Appareil", "--content", message])
        subprocess.run(["termux-vibrate", "-d", "500"])
    sauf FichierIntrouvable:
        afficher("Installe termux-api pour recevoir les notifications")

fonction lire_batterie():
    essayer:
        sortie = subprocess.run(["termux-battery-status"], capture_output=vrai, text=vrai, timeout=10)
        retourner json.loads(sortie.stdout)
    sauf Erreur:
        retourner rien

fonction memoire_libre():
    essayer:
        valeurs = {}
        avec ouvrir("/proc/meminfo") comme f:
            pour ligne dans f:
                morceaux = ligne.separer()
                valeurs[morceaux[0]] = entier(morceaux[1])
        retourner valeurs["MemAvailable:"] * 100 / valeurs["MemTotal:"]
    sauf Erreur:
        retourner rien

fonction stockage_utilise():
    total, utilise, libre = shutil.disk_usage(os.path.expanduser("~"))
    retourner utilise * 100 / total

fonction taille_dossier(dossier):
    somme_o = 0
    pour racine, sous_dossiers, noms dans os.walk(dossier):
        pour nom dans noms:
            essayer:
                somme_o = somme_o + os.path.getsize(os.path.join(racine, nom))
            sauf Erreur:
                passer
    retourner somme_o

fonction gros_fichiers(dossier, combien):
    liste_f = []
    pour racine, sous_dossiers, noms dans os.walk(dossier):
        pour nom dans noms:
            chemin = os.path.join(racine, nom)
            essayer:
                liste_f.ajouter((os.path.getsize(chemin), chemin))
            sauf Erreur:
                passer
    liste_f.trier(reverse=vrai)
    retourner liste_f[:combien]

fonction trouver_apk(dossier):
    resultat = []
    pour racine, sous_dossiers, noms dans os.walk(dossier):
        pour nom dans noms:
            si nom.endswith(".apk"):
                resultat.ajouter(os.path.join(racine, nom))
    retourner resultat

fonction analyser_download():
    si non os.path.exists(DOSSIER_DOWNLOAD):
        retourner ""
    textes = []
    taille_mo = taille_dossier(DOSSIER_DOWNLOAD) / 1000000
    si taille_mo >= SEUIL_DOWNLOAD_MO:
        arrondi = arrondir(taille_mo / 50) * 50
        textes.ajouter("Dossier Download : environ " + chaine(arrondi) + " Mo, fais du tri")
    liste_apk = trouver_apk(DOSSIER_DOWNLOAD)
    si longueur(liste_apk) > 0:
        textes.ajouter(chaine(longueur(liste_apk)) + " installateur(s) .apk à supprimer dans Download")
    retourner " | ".joindre(textes)

fonction controler():
    messages = []

    bat = lire_batterie()
    si bat != rien:
        niveau = bat["percentage"]
        etat = bat["status"]
        chaleur = bat["temperature"]
        en_charge = etat != "DISCHARGING"

        si en_charge:
            si suivi["debut_charge"] == rien:
                suivi["debut_charge"] = temps.maintenant()
        sinon:
            suivi["debut_charge"] = rien

        si en_charge et niveau >= SEUIL_HAUT:
            messages.ajouter("Batterie à " + chaine(niveau) + "% : débranche le chargeur")
        sinonsi etat == "DISCHARGING" et niveau <= SEUIL_CRITIQUE:
            messages.ajouter("Batterie CRITIQUE " + chaine(niveau) + "% : branche vite")
        sinonsi etat == "DISCHARGING" et niveau <= SEUIL_BAS:
            messages.ajouter("Batterie à " + chaine(niveau) + "% : pense à charger")

        si suivi["debut_charge"] != rien:
            heures = (temps.maintenant() - suivi["debut_charge"]) / 3600
            si heures >= HEURES_CHARGE_MAX:
                messages.ajouter("En charge depuis " + chaine(entier(heures)) + " h : débranche, charger trop longtemps use la batterie")

        si chaleur >= SEUIL_CHALEUR:
            si en_charge:
                messages.ajouter("Téléphone chaud (" + chaine(chaleur) + "°C) en charge : arrête de l'utiliser")
            sinon:
                messages.ajouter("Téléphone chaud (" + chaine(chaleur) + "°C) : laisse-le refroidir")

        si bat["health"] != "GOOD":
            messages.ajouter("Santé de la batterie : " + chaine(bat["health"]))

        si suivi["niveau"] != rien et etat == "DISCHARGING" et suivi["niveau"] - niveau >= 2:
            messages.ajouter("Décharge rapide : -" + chaine(suivi["niveau"] - niveau) + "% en 1 minute, ferme les applications gourmandes")
        suivi["niveau"] = niveau

    libre_ram = memoire_libre()
    si libre_ram != rien et libre_ram < SEUIL_RAM:
        messages.ajouter("Mémoire presque pleine : " + chaine(arrondir(libre_ram)) + "% libre")

    plein = stockage_utilise()
    si plein >= SEUIL_STOCKAGE:
        messages.ajouter("Stockage plein à " + chaine(arrondir(plein)) + "%")

    si suivi["cycle"] % 10 == 0:
        suivi["msg_download"] = analyser_download()
    si suivi["msg_download"] != "":
        messages.ajouter(suivi["msg_download"])
    suivi["cycle"] = suivi["cycle"] + 1

    retourner messages

fonction bilan():
    afficher("--- Bilan de ton appareil ---")
    bat = lire_batterie()
    si bat != rien:
        afficher("Batterie :", bat["percentage"], "% |", bat["status"], "|", bat["temperature"], "°C | santé", bat["health"])
    libre_ram = memoire_libre()
    si libre_ram != rien:
        afficher("Mémoire libre :", arrondir(libre_ram), "%")
    afficher("Stockage utilisé :", arrondir(stockage_utilise()), "%")
    afficher("Les 5 plus gros fichiers :")
    pour taille, chemin dans gros_fichiers(os.path.expanduser("~"), 5):
        afficher("  ", arrondir(taille / 1000000), "Mo", chemin)
    afficher("-----------------------------")

afficher("🩺 Docteur Appareil v2 actif (Ctrl+C pour arrêter)")
bilan()
ecrire_journal("Docteur démarré")
dernier = ""
essayer:
    tantque vrai:
        messages = controler()
        texte = " | ".joindre(messages)
        si texte != "" et texte != dernier:
            alerter(texte)
        dernier = texte
        temps.attendre(PAUSE)
sauf KeyboardInterrupt:
    afficher("Docteur arrêté. Prends soin de ton téléphone 🩺")
