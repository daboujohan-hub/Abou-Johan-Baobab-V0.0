importer http.server

page_html = ""
page_html = page_html + "<!DOCTYPE html><html lang='fr'><head><meta charset='utf-8'>"
page_html = page_html + "<meta name='viewport' content='width=device-width, initial-scale=1'>"
page_html = page_html + "<title>DEV.D.A.J.</title>"
page_html = page_html + "<style>"
page_html = page_html + "body{margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;background:#1a1a1a;font-family:sans-serif;color:white}"
page_html = page_html + ".carte{background:#2b2b2b;border-top:8px solid #f77f00;border-bottom:8px solid #009e60;border-radius:16px;padding:30px;width:85%;max-width:360px;text-align:center}"
page_html = page_html + "h1{margin:10px 0 0 0}"
page_html = page_html + ".metier{color:#f77f00;margin:5px 0 20px 0}"
page_html = page_html + "a{display:block;background:#009e60;color:white;text-decoration:none;padding:12px;border-radius:8px;margin:8px 0}"
page_html = page_html + "</style></head><body><div class='carte'>"
page_html = page_html + "<div style='font-size:50px'>🌳</div>"
page_html = page_html + "<h1>DEV.D.A.J.</h1>"
page_html = page_html + "<p class='metier'>Abou Johan · AbouDev · Développeur 🇨🇮</p>"
page_html = page_html + "<p>Fait en Baobab, programmé en français</p>"
page_html = page_html + "<a href='https://github.com/daboujohan-hub'>GitHub</a>"
page_html = page_html + "<a href='https://www.tiktok.com/@aboujohan.dev'>TikTok @aboujohan.dev</a>"
page_html = page_html + "<a href='https://wa.me/2250170404109'>WhatsApp</a>"
page_html = page_html + "</div></body></html>"

classe Carte(http.server.BaseHTTPRequestHandler):
    fonction do_GET(soi):
        soi.send_response(200)
        soi.send_header("Content-Type", "text/html; charset=utf-8")
        soi.end_headers()
        soi.wfile.write(page_html.encode("utf-8"))

serveur = http.server.HTTPServer(("", 8000), Carte)
afficher("Carte sur http://localhost:8000 (Ctrl+C pour arrêter)")
serveur.serve_forever()
